generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Citizen {
  id      Int      @id @default(autoincrement())
  nom     String
  prenom  String
  email   String   @unique
  demandes Demande[]
}

model Demande {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  citizenId Int
  citizen   Citizen @relation(fields: [citizenId], references: [id])

  statusId Int
  status   Status @relation(fields: [statusId], references: [id])
}

model Status {
  id   Int    @id @default(autoincrement())
  name String

  demandes Demande[]
}
model AdminProfile {
  id            Int     @id @default(autoincrement())
  fullName      String
  email         String  @unique
  role          String
  theme         String
  notifications Boolean @default(true)
}